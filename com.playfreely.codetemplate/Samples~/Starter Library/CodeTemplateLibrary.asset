  - TemplateName: "\u827A\u672F\u5B57\u5DE5\u5177"
    CodeContent: "// \u5728\u6B64\u8F93\u5165\u6A21\u677F\u4EE3\u7801\n"
  - TemplateName: "\u64AD\u653E\u97F3\u4E50"
    CodeContent: "// \u5728\u6B64\u8F93\u5165\u6A21\u677F\u4EE3\u7801\n"
  - TemplateName: "\u64AD\u653E\u58F0\u97F3"
    CodeContent: "// \u5728\u6B64\u8F93\u5165\u6A21\u677F\u4EE3\u7801\n"
  - TemplateName: "\u8BBE\u7F6E\u5218\u6D77\u5C4F\u5B89\u5168\u533A"
    CodeContent: "\n// \u8BBE\u7F6E\u5218\u6D77\u5C4F\u5B89\u5168\u533A\n\n\nprotected
      override void OnInit(object userdata)\n{\n    base.OnInit(userdata);\n    GetBindComponents(ComponentTool);\n\n\n   
      // \u83B7\u53D6\u9700\u8981\u8BBE\u7F6E\u7684UI\u8282\u70B9\u7684Trans, \u5728OnInit\u65B9\u6CD5\u4E2D\u52A0\u5165\u4E0B\u9762\u4EE3\u7801\n\n   
      UIExtension.ApplySafeAreaPadding(m_Trans_LeftTopNode);\n    UIExtension.ApplySafeAreaPadding(m_Trans_RightTopNode);\n}"
  - TemplateName: "\u52A8\u6001\u52A0\u8F7D\u56FE\u7247"
    CodeContent: "// \u5728\u6B64\u8F93\u5165\u6A21\u677F\u4EE3\u7801\n"
  - TemplateName: "Spine\u52A8\u753B\u5E38\u7528\u4EE3\u7801"
    CodeContent: "\n\n// \u64AD\u653E\u52A8\u753B(\u5FAA\u73AF)\nm_USpine_RealMonkey.PlayAnimation(\"effect_4\",
      true);\n\n\n// \u64AD\u653E\u52A8\u753B(\u53EA\u64AD\u653E\u4E00\u6B21)\nm_USpine_RealMonkey.PlayAnimation(\"effect_4\");"
  - TemplateName: "Dotween\u52A8\u753B\u5E38\u7528\u4EE3\u7801"
    CodeContent: "// \u5728\u6B64\u8F93\u5165\u6A21\u677F\u4EE3\u7801\n"
  - TemplateName: "\u81EA\u9002\u5E94\u8F93\u5165\u6846"
    CodeContent: "\n\n\nprotected override void OnInit(object userdata)\n{\n    base.OnInit(userdata);\n   
      GetBindComponents(ComponentTool);\n\n    // \u9996\u5148\u9700\u8981\u5728OnInit\u4E2D\u6CE8\u518C\u8F93\u5165\u76D1\u542C\u4E8B\u4EF6\n   
      InitInputListener();\n}\n\n\n// \u6CE8\u518C\u8F93\u5165\u76D1\u542C\u4E8B\u4EF6\nprivate
      void InitInputListener()\n{\n    m_Input_Count.onValueChanged.AddListener(InputChanged);\n}\n\n\n\nprivate
      void InputChanged(string value)\n{\n\n    // \u5F3A\u5236\u5237\u65B0\u5E03\u5C40\uFF08\u81EA\u9002\u5E94\u8F93\u5165\u6846\u6700\u5173\u952E\u7684\u4EE3\u7801\uFF0C\u8FD9\u4E2A\u5FC5\u987B\u52A0\uFF09\n   
      LayoutRebuilder.ForceRebuildLayoutImmediate(m_Input_StorageCount.GetComponent<RectTransform>());\n}"
